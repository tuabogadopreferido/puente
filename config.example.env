NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SIGNING_SECRET=generate-32-or-more-random-characters
APPROVAL_SIGNING_SECRET=generate-another-32-or-more-random-characters
RECEIPT_PRIVATE_KEY=base64-encoded-ed25519-pkcs8-pem
# Public fictional fixture password used by the Try the live demo button.
# If you change it, use the manual sign-in form with your chosen password.
PUENTE_DEMO_PASSWORD=PuenteDemo2026!
# Direct Anthropic is primary. Personal API keys also require their workspace ID.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
# ANTHROPIC_MODEL=claude-opus-5-5
# Effort is low. Without a direct key, use Gateway/OIDC (automatic on Vercel).
# AI_GATEWAY_API_KEY=
# PUENTE_CLAUDE_MODEL=anthropic/claude-opus-5.5
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=
# AGENTMAIL_WEBHOOK_SECRET=
